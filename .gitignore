# ── Python ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── 运行时产物（生成物，可整目录删除）───────────────────────────────
data/
*.db
*.db-wal
*.db-shm

# ── 测试与临时 ──────────────────────────────────────────────────────
.testtmp/
.shots/
.shots-dev/
.pytest_cache/

# ── 前端 ────────────────────────────────────────────────────────────
# （frontend/.gitignore 里还有更细的规则）
node_modules/
frontend/dist/
frontend/.esbuild-tmp/

# ── 故障恢复现场（2026-10-01 postgres.py 损坏事件）──────────────────
# 保留在磁盘上做证据，但不进版本库：里面是坏文件的副本，容易被误用。
_recovery_*/

# ── 模块文件的临时副本 ──────────────────────────────────────────────
# `postgres.merged.py` 这种曾在本次事故中出现：它们是坏掉的模块副本，
# 放在包目录旁边会被工具和后来的人当成真文件。**别再这样拷贝**。
*.merged.py
*.merged[0-9].py
*.rebuilt.py
*.recover*.py
RECOVERED_*.py

# ── 服务端日志（我用 Start-Process 起的本地实例会写这两个）────────
.srv.log
.srv.err
# 换个名字再起一遍就会漏网（.server.log / .server.err 是 2026-10-04 实际用到的）
*.server.log
*.server.err
backend/.server.log
backend/.server.err
nohup.out

# ── 前端构建/开发的临时产物 ────────────────────────────────────────
# Vite 的缓存目录与 dev server 日志（frontend/.gitignore 管不到它们）
frontend/.tmp/
*.vite.log
*.vite.err

# ── PowerShell 误产物 ──────────────────────────────────────────────
# `> $null` 在某些调用形式下会真的在仓库根落一个名为 `$null` 的空文件
/$null

# ── 调试遗留（2026-10-01 排查 postgres.py 损坏时产生）────────────────
# 这些是我和代理在排查过程中落下的中间产物：转录、GBK 码表、形状检查脚本。
# 它们不是代码，不该进版本库，也不该留在包目录旁边误导人。
_transcripts/
backend/_transcripts/
backend/_gbk_*.tsv
backend/_*.py
# 2026-10-04 追加：临时分析脚本一律落在仓库根的 `.testtmp/`（已忽略）。
# 下面这条挡的是"cwd 弄错、脚本落到 backend/ 里"的情况 —— 当时 cwd 在
# backend，Out-File 就近写下了 `.tmpq.py`，差点跟着提交进去。
.tmp*.py
backend/.tmp*.py
